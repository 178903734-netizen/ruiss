{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ruiss",
  "version": "0.2.0",
  "identifier": "com.ruiss.app",
  "build": {
    "frontendDist": "../gui",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "Ruiss 设置",
        "width": 480,
        "height": 760,
        "resizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
